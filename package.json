{
  "name": "danjelito-portfolio",
  "version": "2.0.0",
  "description": "Personal portfolio build scripts",
  "private": true,
  "devDependencies": {
    "uglify-js": "^3.17.4"
  },
  "scripts": {
    "build:js": "uglifyjs assets/js/_main.js -c -m -o assets/js/main.min.js",
    "watch:js": "onchange \"assets/js/_main.js\" -- npm run build:js"
  }
}
